# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# git-ignored, so your keys never get committed.
#
# Leave these unset / empty to keep the app running on local mock data
# (the behavior described in src/data/*.ts and src/lib/dataClient.ts).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
